# Force HTTPS + WWW Redirect + Security + Speed for mahadevbiradar.in
# Created for Dr. Mahadev Biradar Website

# 1. Force HTTPS (Required for AdSense)
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 2. Force www to non-www OR non-www to www (Choose one)
# To force non-www (https://mahadevbiradar.in) - Recommended:
RewriteCond %{HTTP_HOST} ^www\.mahadevbiradar\.in$ [NC]
RewriteRule ^(.*)$ https://mahadevbiradar.in/$1 [L,R=301]

# 3. Remove .html extension for clean URLs (Optional but professional)
# So /privacy.html becomes /privacy
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L,QSA]

# 4. Security Headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 5. Compression for Speed (Better AdSense score)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# 6. Browser Caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>

# 7. Protect sensitive files
<FilesMatch "^\.ht">
  Order allow,deny
  Deny from all
</FilesMatch>

# 8. Prevent directory listing
Options -Indexes

# 9. Custom 404 - Redirect to home (optional)
# ErrorDocument 404 /index.html
